<% if authenticated? %>
  <nav class="navbar bg-black py-2">
    <div class="container">
      <div class="d-flex justify-content-between w-100">
        <%= image_tag "logo-light.svg", width: "140px", alt: "CardStack" %>
        <div class="d-flex gap-5 align-items-center">
          <p class="text-white m-0">Hi, <%= current_user[:name] %></p>
          <%= button_to "Sign Out", session_path, method: :delete, class: "btn btn-danger d-flex align-items-center btn-sm"  %>
        </div>
      </div>
    </div>
  </nav>
<% end %>