<section>
  <div class="container">
    ===========================
    <h2><%= @card[:name] %></h2>
    <p><%= @card[:card_number] %><p>
    <p><%= @card[:card_type] %><p>

    <%= link_to "Edit card", edit_card_path(@card), class: "btn btn-info btn-sm"%>
    <%= link_to "View Bills", card_bills_path(@card), class: "btn btn-info btn-sm"%>
    <%= link_to "Add Bill", new_card_bill_path(@card), class: "btn btn-info btn-sm"%>
    <%= button_to "Delete card", @card, method: :delete, class: "btn btn-danger btn-sm"%>
    ===========================
    <div>
      <%= link_to "Go Back", cards_path, class: "btn btn-info btn-sm" %>
    </div>
  </div>
</section>