<section>
  <div class="container">
    <% if card.errors.any? %>
      <ul>
        <% card.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
    <%= form_with model: card, class: "d-flex flex-column gap-3", html: {autocomplete: "off"} do |f| %>
      <%= f.text_field :name, placeholder: "Card name" %>
      <%= f.select :bank, Card.banks.values %>
      <%= f.text_field :number, placeholder: "Card number" %>
      <%= f.text_field :milestones_string, value: card.milestones_string, placeholder: "Milestone1; Milestone2; Milestone3..." %>
      <%= f.select :expiry_month, [
        ["01", "1"],
        ["02", "2"],
        ["03", "3"],
        ["04", "4"],
        ["05", "5"],
        ["06", "6"],
        ["07", "7"],
        ["08", "8"],
        ["09", "9"],
        ["10", "10"],
        ["11", "11"],
        ["12", "12"],
        ], { selected: card.expiry_month || Time.current.month } %>
      <%= f.select :expiry_year, (Time.current.year)..(Time.current.year + 10), { selected:  card.expiry_year || Time.current.year } %>
      <%= f.submit %>
    <% end %>
  </div>
</section>